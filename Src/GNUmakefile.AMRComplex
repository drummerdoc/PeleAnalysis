# Standalone makefile for the AMRComplex sources.
#
# Deliberately independent of Make.Analysis and therefore of PelePhysics:
# AMRComplex depends on AMReX alone, and keeping it that way means it builds
# wherever AMReX does.
#
#   make -f GNUmakefile.AMRComplex AMREX_HOME=<path>
#
# NOTE: a driver must not be the case-variant of a library source. On a
# case-insensitive filesystem amrComplex.cpp IS AMRComplex.cpp and amrJointStats.cpp
# IS AMRJointStats.cpp: the second file written replaces the first, one object is
# built instead of two, and the link fails on every library symbol with
# "referenced from _main". Hence amrComplexVerify.cpp and amrJointFit.cpp.
# Tools/amrBuildAndTest.sh checks for this before building anything.

AMREX_HOME ?= ../../amrex

DEBUG     = FALSE

# 2D and 3D are both supported and both verified. Override on the command
# line: make -f GNUmakefile.AMRComplex DIM=2
DIM      ?= 3
PRECISION = DOUBLE
COMP      = gnu
USE_MPI   = FALSE
USE_OMP   = FALSE
USE_CUDA  = FALSE

# AMRComplex contains no Fortran; skipping it keeps the build portable to
# toolchains without a Fortran compiler.
BL_NO_FORT = TRUE

EBASE ?= amrComplexVerify

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

CEXE_headers += AMRComplex.H  AMRContour.H  AMRSegment.H  AMRParallel.H  AMRJointStats.H
CEXE_sources += AMRComplex.cpp AMRContour.cpp AMRSegment.cpp AMRParallel.cpp AMRJointStats.cpp
CEXE_sources += $(EBASE).cpp

# amrGradStats takes its gradients from a composite MLPoisson apply, so it needs
# the linear solvers and what they rest on; amrGradVerify shares the build tree
# with it. Everything else is AMReX Base alone, and stays that way: the extra
# directories are not linked into the other tools.
#
# amrCurvVerify reads a plotfile amrGradStats wrote and needs none of the
# solver itself, but it is built in the same tree so the two always come from
# one configuration -- a verifier compiled against a different build of the
# thing it verifies is worse than no verifier.
GRAD_TARGETS := amrGradStats amrGradVerify amrCurvVerify
ifneq ($(filter $(EBASE),$(GRAD_TARGETS)),)
  Pdirs := Base Boundary AmrCore LinearSolvers
  ifeq ($(EBASE),amrGradStats)
    CEXE_headers += AMRGradient.H
    CEXE_sources += AMRGradient.cpp
  endif
else
  Pdirs := Base
endif
Ppack += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
include $(Ppack)

INCLUDE_LOCATIONS += .

include $(AMREX_HOME)/Tools/GNUMake/Make.rules
