# Standalone makefile for the AMRComplex sources.
#
# Deliberately independent of Make.Analysis and therefore of PelePhysics:
# AMRComplex depends on AMReX alone, and keeping it that way means it builds
# wherever AMReX does.
#
#   make -f GNUmakefile.AMRComplex AMREX_HOME=<path>
#
# NOTE: the driver is amrComplexVerify.cpp, not amrComplex.cpp -- on a
# case-insensitive filesystem the latter would collide with AMRComplex.cpp and
# produce a single object file holding both translation units.

AMREX_HOME ?= ../../amrex

DEBUG     = FALSE
DIM       = 3
PRECISION = DOUBLE
COMP      = gnu
USE_MPI   = FALSE
USE_OMP   = FALSE
USE_CUDA  = FALSE

# AMRComplex contains no Fortran; skipping it keeps the build portable to
# toolchains without a Fortran compiler.
BL_NO_FORT = TRUE

EBASE ?= amrComplexVerify

include $(AMREX_HOME)/Tools/GNUMake/Make.defs

CEXE_headers += AMRComplex.H
CEXE_sources += AMRComplex.cpp
CEXE_sources += $(EBASE).cpp

Pdirs := Base
Ppack += $(foreach dir, $(Pdirs), $(AMREX_HOME)/Src/$(dir)/Make.package)
include $(Ppack)

INCLUDE_LOCATIONS += .

include $(AMREX_HOME)/Tools/GNUMake/Make.rules
